{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://enessozdemir.github.io/portfolio",
  "scripts": {
    "dev": "tailwindcss -i ./src/styles/tailwind-input.css -o ./public/output.css --watch & next dev",
    "build:css": "tailwindcss -i ./src/styles/tailwind-input.css -o ./public/output.css --minify",
    "build": "npm run build:css && next build",
    "build:export": "npm run build:css && cross-env GITHUB_PAGES=true NEXT_PUBLIC_BASE_PATH=/portfolio next build && touch out/.nojekyll",
    "deploy": "npm run build:export && gh-pages -d out -b gh-pages --dotfiles",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "lucide-react": "^1.79.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.7.0",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  }
}
